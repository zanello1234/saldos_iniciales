<odoo>
    <data>

        <record id="view_account_move_inherit_saldos" model="ir.ui.view">
            <field name="name">account.move.form.inherit.saldos</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="currency_id" position="after">
                    <field name="file_amount" readonly="1"/>
                </field>
            </field>
        </record>

        <record id="view_account_iva_file_tree" model="ir.ui.view">
            <field name="name">account.iva.file.tree</field>
            <field name="model">account.iva.file</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="operation_type"/>
                    <field name="date"/>
                    <field name="usd_exchange_rate"/>
                    <field name="journal_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_account_iva_file_form" model="ir.ui.view">
            <field name="name">account.iva.file.form</field>
            <field name="model">account.iva.file</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="btn_analyze_file" 
                                string="Analizar Archivo" 
                                type="object"
                                invisible="state != 'draft'"
                                class="btn-secondary"/>
                        <button name="btn_process_file" 
                                string="Procesar Archivo" 
                                type="object"
                                invisible="state != 'draft'"
                                class="btn-primary"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nombre del proceso"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="operation_type" widget="radio" options="{'horizontal': true}"/>
                                <field name="journal_id" required="1" readonly="state != 'draft'"/>
                                <field name="product_id" required="1" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="separator"/>
                                <field name="iva_file" filename="filename" readonly="state != 'draft'"/>
                                <field name="filename" invisible="1"/>
                            </group>
                        </group>
                        <group string="Tipo de Cambio">
                            <group>
                                <field name="update_exchange_rates"/>
                                <field name="usd_exchange_rate" invisible="update_exchange_rates == False"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Facturas Creadas">
                                <field name="move_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="move_type"/>
                                        <field name="invoice_date"/>
                                        <field name="partner_id"/>
                                        <field name="currency_id"/>
                                        <field name="amount_total"/>
                                        <field name="file_amount"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Contactos Creados">
                                <field name="partner_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="vat"/>
                                        <field name="supplier_rank"/>
                                        <field name="customer_rank"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Tipos de Cambio Actualizados">
                                <field name="currency_rate_ids" readonly="1">
                                    <list>
                                        <field name="name" string="Fecha"/>
                                        <field name="currency_id" string="Moneda"/>
                                        <field name="rate" string="Tipo de Cambio (Odoo)"/>
                                        <field name="company_id"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_account_iva_file" model="ir.actions.act_window">
            <field name="name">Importar Saldos</field>
            <field name="res_model">account.iva.file</field>
            <field name="view_mode">list,form</field>
            <field name="target">current</field>
        </record>

        <!-- Menú principal - usar un External ID que SÍ existe -->
        <menuitem
            id="menu_account_iva_import"
            name="Importar Saldos"
            action="action_account_iva_file"
            parent="account.menu_finance_entries"
            sequence="200"/>

    </data>
</odoo>