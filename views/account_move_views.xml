<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Account Move Form to show import file reference -->
    <record id="view_account_move_form_inherit_import" model="ir.ui.view">
        <field name="name">account.move.form.inherit.import</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="file_amount" readonly="1" invisible="not file_amount"/>
            </field>
        </field>
    </record>

</odoo>
