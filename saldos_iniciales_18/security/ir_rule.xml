<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Regla para filtrar archivos de importación por compañía -->
        <record model="ir.rule" id="account_iva_file_company_rule">
            <field name="name">Archivos de Importación Multi-Compañía</field>
            <field name="model_id" ref="model_account_iva_file"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
    </data>
</odoo>